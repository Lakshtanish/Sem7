#removing outliers
def removeOutliers(df1, column):
  Q1 = df1[column].quantile(0.25)
  Q3 = df1[column].quantile(0.75)
  iqr = Q3 - Q1
  lower = Q1 - 1.5*iqr
  upper = Q3 + 1.5*iqr
  df[column] = np.clip(df1[column], lower, upper)
  return df1

def treatOutliers(df1, columns):
  for c in columns:
    df1 = removeOutliers(df, c)
  return df1

df = treatOutliers(df, df.iloc[:, 0::])
df.plot(kind="box", subplots=True, layout=(7,2), figsize=(15, 20))




travel_dist = []
for p in range(len(df['pickup_latitude'])):
  long1, lat1, long2, lat2 = [df['pickup_longitude'][p], df['pickup_latitude'][p], df['dropoff_longitude'][p], df['dropoff_latitude'][p]]
  c = hs.haversine((lat1, long1), (lat2, long2))
  travel_dist.append(c)

print(travel_dist)
